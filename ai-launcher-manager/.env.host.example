# Host worker settings.
# This file is intended for `python -m app.host_worker --env-file .env.host.example`

AILM_REDIS_URL=redis://localhost:6381/0
AILM_SCHEDULER_POLL_INTERVAL_SECONDS=3
AILM_MONITOR_POLL_INTERVAL_SECONDS=5
AILM_TMUX_SESSION_NAME=ai-launcher-manager
AILM_TMUX_HISTORY_LINES=200
AILM_TMUX_CLEANUP_ON_TERMINAL_STATE=true
AILM_ENABLE_BACKGROUND_WORKER=true
AILM_WORKER_ID=host-worker-1
AILM_CLASSIFIER_ENABLED=true
AILM_CLASSIFIER_COMMAND=codex
AILM_CLASSIFIER_MODEL=
AILM_CLASSIFIER_TIMEOUT_SECONDS=45
AILM_CLASSIFIER_MIN_INTERVAL_SECONDS=30
AILM_CLASSIFIER_MAX_INTERVAL_SECONDS=300
AILM_CLASSIFIER_MIN_CONFIDENCE=0.65
AILM_CLASSIFIER_MAX_OUTPUT_CHARS=8000
AILM_STUCK_IDLE_TIMEOUT_SECONDS=900
AILM_PROMPT_DELIVERY_TIMEOUT_SECONDS=20
AILM_MAX_PROMPT_DELIVERY_ATTEMPTS=3
AILM_INITIAL_CONCURRENCY_PER_PROVIDER=5
AILM_MIN_CONCURRENCY_PER_PROVIDER=1
AILM_MAX_CONCURRENCY_PER_PROVIDER=10
AILM_CONCURRENCY_INCREASE_AFTER_SUCCESSES=3
AILM_CONCURRENCY_DECREASE_STEP=1
AILM_LOG_LEVEL=INFO
